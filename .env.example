# Copy to .env (or set these as real environment variables / IDE run-config
# variables) ONLY if you want VS Code to connect to a remote database
# (e.g. your Render MySQL instance) instead of the local one started by
# `docker compose up -d`.
#
# If you leave these unset, the app now falls back to the local defaults in
# application.properties (jdbc:mysql://localhost:3306/jobportal, user
# "jobportal", password "jobportal") - matching docker-compose.yml and
# DB_Scripts/, so local development works out of the box.

SPRING_DATASOURCE_URL=jdbc:mysql://<your-render-host>:3306/<your-db-name>?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<your-db-username>
SPRING_DATASOURCE_PASSWORD=<your-db-password>
